{
  "name": "simeta-frontend-web-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "contract:fetch": "ts-node scripts/fetch-contract.ts",
    "types:sync": "pnpm dlx openapi-typescript src/contracts/openapi.v1.json -o src/types/api-generated.ts",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "openapi-typescript": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}